# Copy to .env and set a unique random secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Optional: set this before registering the campus administrator account.
ADMIN_EMAIL=admin@yourcollege.edu
# Local development defaults to SQLite when DATABASE_URL is omitted.
# To use PostgreSQL locally, uncomment and replace with your Neon connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set to 1 only for local debugging; never enable in production.
FLASK_DEBUG=0
